# Copy to .env for local dev; set the same keys in Vercel → Settings →
# Environment Variables (Production and Preview).
#
# VITE_* values are inlined into the browser bundle at build time and are
# public by design — row level security is what protects the data, not the
# secrecy of the anon key. Everything without the VITE_ prefix is server-only.
# Never put a VITE_ prefix on a secret.

# --- Supabase (required) ---------------------------------------------------
# Vercel's Supabase integration injects these automatically under its own names
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SECRET_KEY) and all of them are
# recognised — connect it and skip this block entirely. For local dev, set:
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# SECRET. Bypasses row level security. Used only by the service-role client in
# src/lib/api/_shared.server.ts, never in the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- Email via Resend (optional) -------------------------------------------
# Without RESEND_API_KEY the app still runs: sends are skipped and logged, and
# the dashboard remains the source of truth for every message.
RESEND_API_KEY=""

# Svix signing secret from Resend → Webhooks. Starts whsec_. Without it,
# /api/inbound-email refuses every request rather than trusting unsigned posts.
RESEND_WEBHOOK_SECRET=""

# Where form notifications land, and the addresses mail is sent as. FORM_FROM's
# domain must be verified in Resend or sending returns 403.
FORM_TO="contact@yourdomain.com"
FORM_FROM="Lifewell Website <website@yourdomain.com>"
MAILBOX_ADDRESS="Lifewell Medical <contact@yourdomain.com>"

# Optional safety copy of every inbound message. MUST be a mailbox on another
# domain — pointing it at one of this site's own addresses loops mail back into
# the webhook until the sending quota is gone. /api/health warns if it would.
FORWARD_TO=""
