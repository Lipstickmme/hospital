# Copy to .env for local dev; set the same keys in Vercel → Settings → Environment Variables.
#
# VITE_* values are inlined into the browser bundle at build time and are public
# by design. Everything without the VITE_ prefix is server-only — never add a
# VITE_ prefix to a secret.

# --- Supabase (required) ---------------------------------------------------
# Project URL and publishable ("anon") key. Safe to expose; RLS is what protects
# the data. Both spellings are read, so either works.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-side copies, used by the SSR handler and server functions.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# SECRET. Bypasses row level security. Used only by the service-role client in
# src/lib/api/_shared.server.ts. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Email via Resend (optional) -------------------------------------------
# Without RESEND_API_KEY the app still runs: sends are skipped and logged, and
# the dashboard remains the source of truth for every message.
RESEND_API_KEY=""

# Must match the domain verified in Resend exactly, or sending returns 403.
MAIL_DOMAIN="lifewellmedicalcenter.example"

# Derived from MAIL_DOMAIN when unset. Override to change any one of them.
FORM_TO=""
FORM_FROM=""
MAILBOX_ADDRESS=""

# --- Inbound mail (optional) -----------------------------------------------
# Svix signing secret from Resend → Webhooks. Starts whsec_. Without it,
# /api/inbound-email refuses every request rather than trusting unsigned posts.
RESEND_WEBHOOK_SECRET=""

# Optional safety copy of every inbound message. MUST be a mailbox on another
# domain — pointing it at one of this site's own addresses loops mail back into
# the webhook until the sending quota is gone. /api/health warns if it would.
FORWARD_TO=""
